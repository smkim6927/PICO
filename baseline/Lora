# ─────────────────────────────────────────────────────────────────────────────
# Reproducibility helpers
# ─────────────────────────────────────────────────────────────────────────────
def set_seed(seed: int, deterministic: bool = True):
    random.seed(seed)
    np.random.seed(seed)
    accelerate_set_seed(seed)
    torch.manual_seed(seed)
    torch.cuda.manual_seed(seed)
    torch.cuda.manual_seed_all(seed)
    if deterministic:
        torch.backends.cudnn.deterministic = True
        torch.backends.cudnn.benchmark = False
        torch.backends.cuda.matmul.allow_tf32 = False
        torch.backends.cudnn.allow_tf32 = False
        try:
            torch.use_deterministic_algorithms(True, warn_only=True)
        except Exception:
            pass


def seed_worker(worker_id: int):
    worker_seed = torch.initial_seed() % (2**32)
    np.random.seed(worker_seed)
    random.seed(worker_seed)


# ─────────────────────────────────────────────────────────────────────────────
# Left-pad utilities (tokenizer.padding_side="left" 와 일치)
# ─────────────────────────────────────────────────────────────────────────────
def left_pad_sequence(sequences, padding_value=0):
    max_len = max(s.size(0) for s in sequences)
    padded = []
    for s in sequences:
        pad_size = max_len - s.size(0)
        if pad_size > 0:
            s = torch.nn.functional.pad(s, (pad_size, 0), value=padding_value)
        padded.append(s)
    return torch.stack(padded, dim=0)


def assert_left_padded(input_ids, attention_mask):
    bsz, _ = attention_mask.shape
    for i in range(bsz):
        zeros = (attention_mask[i] == 0).nonzero(as_tuple=True)[0]
        ones = (attention_mask[i] == 1).nonzero(as_tuple=True)[0]
        if len(zeros) == 0 or len(ones) == 0:
            continue
        if zeros.max() >= ones.min():
            return False
    return True


# ─────────────────────────────────────────────────────────────────────────────
# Trainer: LoRA + Continual Pre-Training (No Replay)
#
# CPT 흐름:
#   - 단일 LoRA adapter를 4개 도메인에 걸쳐 *누적적으로* 학습
#   - 매 stage 종료 후 (옵션) adapter 체크포인트 저장
#   - 마지막 stage 종료 후 merged full model export
# ─────────────────────────────────────────────────────────────────────────────
class LoRATrainer:
    def __init__(
        self,
        model_name: str,
        dataset_list: List[str],
        output_dir: str,
        batch_size: int = 4,
        seed: int = 777,
        num_epochs: int = 1,
        learning_rate: float = 2e-4,      # ← LoRA는 base보다 큰 LR이 표준
        max_length: int = 256,
        chunk_size: int = 64,
        gradient_accumulation_steps: int = 8,
        num_workers: int = 4,
        # ── LoRA hyperparameters ─────────────────────────────────────
        lora_r: int = 16,                 # ← 4-stage CPT는 8보다 16 권장
        lora_alpha: int = 32,             # alpha = 2*r 관행
        lora_dropout: float = 0.05,
        lora_target_modules: Optional[List[str]] = None,
        # ── Save options ─────────────────────────────────────────────
        save_per_stage_adapter: bool = True,
        save_full_merged_model: bool = True,
        merge_safe: bool = True,
        # ── Misc ─────────────────────────────────────────────────────
        debug: bool = True,
        use_wandb: bool = True,
    ):
        if not dataset_list:
            raise ValueError("dataset_list must be a non-empty list.")

        self.model_name = model_name
        self.tokenizer_name = model_name
        self.dataset_list = dataset_list
        self.output_dir = output_dir
        self.batch_size = batch_size
        self.seed = seed
        self.num_epochs = num_epochs
        self.learning_rate = learning_rate
        self.max_length = max_length
        self.chunk_size = chunk_size
        self.gradient_accumulation_steps = gradient_accumulation_steps
        self.num_workers = num_workers

        self.lora_r = lora_r
        self.lora_alpha = lora_alpha
        self.lora_dropout = lora_dropout
        self.lora_target_modules = lora_target_modules

        self.save_per_stage_adapter = save_per_stage_adapter
        self.save_full_merged_model = save_full_merged_model
        self.merge_safe = merge_safe

        self.debug = debug
        self.use_wandb = use_wandb

        set_seed(self.seed, deterministic=True)

        # ── FSDP plugin ─────────────────────────────────────────────
        auto_wrap_policy = partial(
            transformer_auto_wrap_policy,
            transformer_layer_cls={LlamaDecoderLayer},
        )
        fsdp_plugin = FullyShardedDataParallelPlugin(
            auto_wrap_policy=auto_wrap_policy,
            state_dict_config=FullStateDictConfig(offload_to_cpu=True, rank0_only=False),
            optim_state_dict_config=FullOptimStateDictConfig(offload_to_cpu=True, rank0_only=False),
            use_orig_params=True,
        )

        self.accelerator = Accelerator(
            gradient_accumulation_steps=self.gradient_accumulation_steps,
            mixed_precision="bf16",
            fsdp_plugin=fsdp_plugin,
        )
        self.device = self.accelerator.device

        if self.debug and self.accelerator.is_main_process:
            print(f"\n{'=' * 60}")
            print("[INFO] LoRA + Continual Pre-Training (NO REPLAY)")
            print(f"{'=' * 60}")
            print(f"# processes      : {self.accelerator.num_processes}")
            print(f"Device           : {self.device}")
            print(f"# stages         : {len(self.dataset_list)}")
            print(f"LoRA r/alpha/dr  : {self.lora_r}/{self.lora_alpha}/{self.lora_dropout}")
            print(f"Effective bsz    : {self.batch_size * self.gradient_accumulation_steps}")
            print(f"padding_side     : left")
            print(f"{'=' * 60}\n")

        self.wandb_initialized = False
        self._collate_debug_done = False
        self.tokenizer = None
        self.model = None
        self.optimizer = None
        self.global_update_step = 0
        self.current_stage_idx = 0

        # Adapter source tracking
        self.is_input_adapter: bool = False
        self.base_model_path_for_adapter: Optional[str] = None

        os.makedirs(self.output_dir, exist_ok=True)

    # ─────────────────────────────────────────────────────────────────
    # Helpers
    # ─────────────────────────────────────────────────────────────────
    def _is_local_adapter_dir(self, path: str) -> bool:
        return os.path.isdir(path) and os.path.exists(os.path.join(path, "adapter_config.json"))

    def _resolve_model_source(self) -> Tuple[bool, Optional[str]]:
        if self._is_local_adapter_dir(self.model_name):
            peft_cfg = PeftConfig.from_pretrained(self.model_name)
            return True, peft_cfg.base_model_name_or_path
        return False, None

    def _default_target_modules(self) -> List[str]:
        # Llama 3.2 표준
        return ["q_proj", "k_proj", "v_proj", "o_proj",
                "gate_proj", "up_proj", "down_proj"]

    def _cast_trainable_params_to_bf16(self):
        for _, p in self.model.named_parameters():
            if p.requires_grad:
                p.data = p.data.to(torch.bfloat16)

    # ─────────────────────────────────────────────────────────────────
    # Model & Tokenizer
    # ─────────────────────────────────────────────────────────────────
    def load_model_and_tokenizer(self):
        self.is_input_adapter, self.base_model_path_for_adapter = self._resolve_model_source()

        if self.accelerator.is_main_process:
            if self.is_input_adapter:
                print(f"[LoRA] Detected PEFT adapter checkpoint: {self.model_name}")
                print(f"[LoRA] Base model: {self.base_model_path_for_adapter}")
            else:
                print(f"[LoRA] Loading base/full model: {self.model_name}")

        # ── Tokenizer (left-pad, 다른 baseline과 통일) ──────────────
        tokenizer_source = self.model_name if not self.is_input_adapter else self.base_model_path_for_adapter
        try:
            self.tokenizer = AutoTokenizer.from_pretrained(
                self.model_name, padding_side="left", trust_remote_code=True
            )
        except Exception:
            self.tokenizer = AutoTokenizer.from_pretrained(
                self.base_model_path_for_adapter, padding_side="left", trust_remote_code=True
            )
        if self.tokenizer.pad_token is None:
            self.tokenizer.pad_token = self.tokenizer.eos_token
            self.tokenizer.pad_token_id = self.tokenizer.eos_token_id
        self.tokenizer.padding_side = "left"

        # ── Base model load ─────────────────────────────────────────
        if self.is_input_adapter:
            base_model = AutoModelForCausalLM.from_pretrained(
                self.base_model_path_for_adapter,
                torch_dtype=torch.bfloat16,
                trust_remote_code=True,
            )
            self.model = PeftModel.from_pretrained(
                base_model,
                self.model_name,
                is_trainable=True,
                autocast_adapter_dtype=False,
            )
        else:
            base_model = AutoModelForCausalLM.from_pretrained(
                self.model_name,
                torch_dtype=torch.bfloat16,
                trust_remote_code=True,
            )
            if self.lora_target_modules is None:
                self.lora_target_modules = self._default_target_modules()
            lora_config = LoraConfig(
                r=self.lora_r,
                lora_alpha=self.lora_alpha,
                target_modules=self.lora_target_modules,
                lora_dropout=self.lora_dropout,
                bias="none",
                task_type=TaskType.CAUSAL_LM,
                inference_mode=False,
            )
            self.model = get_peft_model(
                base_model, lora_config, autocast_adapter_dtype=False
            )

        self.model.config.pad_token_id = self.tokenizer.pad_token_id
        self.model.config.use_cache = False
        # 메모리 절약: LoRA + gradient checkpointing
        self.model.gradient_checkpointing_enable()
        # PEFT는 입력에 require_grad 활성화 필요 (gradient checkpointing 호환)
        if hasattr(self.model, "enable_input_require_grads"):
            self.model.enable_input_require_grads()
        self.model.train()
        self._cast_trainable_params_to_bf16()

        trainable, total = self.model.get_nb_trainable_parameters()
        if self.accelerator.is_main_process:
            print(f"[LoRA] Trainable: {trainable:,} / Total: {total:,} "
                  f"({100*trainable/total:.4f}%)")

        # ── Optimizer (trainable LoRA 파라미터만) ───────────────────
        trainable_params = [p for p in self.model.parameters() if p.requires_grad]
        raw_optimizer = AdamW(
            trainable_params,
            lr=self.learning_rate,
            betas=(0.9, 0.999),
            eps=1e-8,
            weight_decay=0.0,   # LoRA에서 weight decay는 보통 0
        )

        # ── FSDP prepare 단 1회: model + optimizer ─────────────────
        self.model, self.optimizer = self.accelerator.prepare(
            self.model, raw_optimizer
        )

        if self.debug and self.accelerator.is_main_process:
            print(f"[DEBUG] padding_side : {self.tokenizer.padding_side}")
            print(f"[DEBUG] pad_token_id : {self.tokenizer.pad_token_id}")
            print(f"[DEBUG] FSDP prepared once for LoRA model + AdamW")

    # ─────────────────────────────────────────────────────────────────
    # Data
    # ─────────────────────────────────────────────────────────────────
    def _make_collate_fn(self):
        self._collate_debug_done = False

        def _collate_fn(batch):
            pad_id = int(
                self.tokenizer.pad_token_id
                if self.tokenizer.pad_token_id is not None
                else 0
            )
            input_ids_list = [item["input_ids"] for item in batch]
            attention_mask_list = [item["attention_mask"] for item in batch]

            input_ids_padded = left_pad_sequence(input_ids_list, padding_value=pad_id)
            attention_mask_padded = left_pad_sequence(attention_mask_list, padding_value=0)
            labels_padded = input_ids_padded.clone()
            labels_padded[attention_mask_padded == 0] = -100

            if (self.debug and not self._collate_debug_done
                    and self.accelerator.is_main_process):
                self._collate_debug_done = True
                valid = (labels_padded != -100).sum().item()
                mismatch = (
                    (input_ids_padded == pad_id) ^ (attention_mask_padded == 0)
                ).sum().item()
                is_left = assert_left_padded(input_ids_padded, attention_mask_padded)
                print(
                    f"[debug][collate] pad_id={pad_id}, bsz={len(batch)}, "
                    f"seq_len={input_ids_padded.size(1)}, "
                    f"valid_labels={valid}, pad_mask_mismatch={mismatch}, "
                    f"left_padded={is_left}"
                )

            return {
                "input_ids": input_ids_padded,
                "attention_mask": attention_mask_padded,
                "labels": labels_padded,
            }
        return _collate_fn

    def prepare_data(self, txt_file: str):
        dataset = TextDatasetwchunk(
            txt_file=txt_file,
            tokenizer=self.tokenizer,
            max_length=self.max_length,
            chunk_size=self.chunk_size,
        )
        g = torch.Generator()
        g.manual_seed(self.seed)

        loader = DataLoader(
            dataset,
            batch_size=self.batch_size,
            shuffle=True,
            collate_fn=self._make_collate_fn(),
            num_workers=self.num_workers,
            pin_memory=torch.cuda.is_available(),
            worker_init_fn=seed_worker,
            generator=g,
            persistent_workers=False,
            drop_last=False,
        )
        return dataset, loader

    # ─────────────────────────────────────────────────────────────────
    # W&B (전체 stream을 하나의 run으로)
    # ─────────────────────────────────────────────────────────────────
    def _init_wandb(self, dataset_name: str):
        if self.wandb_initialized:
            return
        if not self.use_wandb:
            wandb.init(mode="disabled")
            self.wandb_initialized = True
            return

        if self.accelerator.is_main_process:
            name_map = {
                "new-medical-kor-dataset": "kor-medical",
                "guidline_medical": "eng-medical",
                "new-legal-kor-dataset": "kor-legal",
                "eng-new-legal-dataset": "eng-legal",
            }
            wname = next(
                (v for k, v in name_map.items() if k in dataset_name),
                dataset_name,
            )
            wandb.init(
                project="lora-continual-pretraining",
                config={
                    "method": "LoRA",
                    "optimizer": "AdamW",
                    "learning_rate": self.learning_rate,
                    "model": self.model_name,
                    "lora_r": self.lora_r,
                    "lora_alpha": self.lora_alpha,
                    "lora_dropout": self.lora_dropout,
                    "lora_target_modules": self.lora_target_modules,
                    "num_epochs": self.num_epochs,
                    "batch_size": self.batch_size,
                    "effective_batch_size": self.batch_size * self.gradient_accumulation_steps,
                    "gradient_accumulation_steps": self.gradient_accumulation_steps,
                    "max_length": self.max_length,
                    "chunk_size": self.chunk_size,
                    "seed": self.seed,
                    "padding_side": "left",
                    "fsdp": True,
                    "num_stages": len(self.dataset_list),
                    "replay": False,
                },
                name=f"lora_r{self.lora_r}_ep{self.num_epochs}_{wname}_{self.seed}",
                group="lora_cpt",
            )
        else:
            wandb.init(mode="disabled")
        self.wandb_initialized = True

    # ─────────────────────────────────────────────────────────────────
    # Save
    # ─────────────────────────────────────────────────────────────────
    def _save_adapter(self, dataset_name: str, epoch: int):
        """FSDP-safe LoRA adapter 저장."""
        self.accelerator.wait_for_everyone()
        save_path = os.path.join(self.output_dir, f"{dataset_name}_epoch_{epoch}_adapter")
        if self.accelerator.is_main_process:
            os.makedirs(save_path, exist_ok=True)

        unwrapped = self.accelerator.unwrap_model(self.model)
        state_dict = self.accelerator.get_state_dict(self.model)
        unwrapped.save_pretrained(
            save_path,
            is_main_process=self.accelerator.is_main_process,
            save_function=self.accelerator.save,
            state_dict=state_dict,
        )
        if self.accelerator.is_main_process:
            self.tokenizer.save_pretrained(save_path)
            print(f"✅ LoRA adapter saved: {save_path}")
        self.accelerator.wait_for_everyone()
        return save_path

    def _export_full_merged_model(self, final_adapter_dir: str):
        """모든 stage 완료 후 rank-0에서만 merged full model export."""
        if not self.accelerator.is_main_process:
            return
        merged_dir = os.path.join(self.output_dir, "full_model_final")
        os.makedirs(merged_dir, exist_ok=True)
        print(f"[LoRA] Exporting merged full model → {merged_dir}")

        base_source = self.base_model_path_for_adapter if self.is_input_adapter else self.model_name
        base_model = AutoModelForCausalLM.from_pretrained(
            base_source,
            torch_dtype=torch.bfloat16,
            device_map="cpu",
            trust_remote_code=True,
        )
        peft_model = PeftModel.from_pretrained(
            base_model, final_adapter_dir, autocast_adapter_dtype=False
        )
        merged = peft_model.merge_and_unload(safe_merge=self.merge_safe)
        merged.save_pretrained(merged_dir)
        self.tokenizer.save_pretrained(merged_dir)
        print(f"✅ Merged full model saved: {merged_dir}")

        del base_model, peft_model, merged
        gc.collect()
        if torch.cuda.is_available():
            torch.cuda.empty_cache()

    # ─────────────────────────────────────────────────────────────────
    # Train a single stage
    # ─────────────────────────────────────────────────────────────────
    def train_on_dataset(self, dataloader, dataset_name: str) -> str:
        self._init_wandb(dataset_name)

        if self.accelerator.is_main_process:
            print(f"[INFO] [LoRA/CPT] Training on: {dataset_name} "
                  f"(stage {self.current_stage_idx + 1}/{len(self.dataset_list)})")

        dataloader = self.accelerator.prepare(dataloader)

        last_save_path = ""

        for epoch in range(self.num_epochs):
            set_seed(self.seed + epoch, deterministic=True)
            self.model.train()
            loss_sum, n_step = 0.0, 0

            progress_bar = tqdm(
                dataloader,
                desc=f"{dataset_name} | Epoch {epoch + 1}/{self.num_epochs}",
                disable=not self.accelerator.is_main_process,
                leave=False,
            )

            for step, batch in enumerate(progress_bar):
                input_ids = batch["input_ids"]
                attention_mask = batch["attention_mask"]
                labels = batch["labels"]

                if self.debug and step == 0 and self.accelerator.is_main_process:
                    valid_cnt = (labels != -100).sum().item()
                    is_left = assert_left_padded(input_ids, attention_mask)
                    print(
                        f"[debug][train] {dataset_name} | "
                        f"bsz={input_ids.size(0)}, seq_len={input_ids.size(1)}, "
                        f"valid_labels={valid_cnt}, left_padded={is_left}"
                    )

                valid_cnt = (labels != -100).sum().item()
                if valid_cnt == 0:
                    if self.debug and self.accelerator.is_main_process:
                        print(f"[warn] step {step}: no valid labels, skip")
                    continue

                with self.accelerator.accumulate(self.model):
                    outputs = self.model(
                        input_ids=input_ids,
                        attention_mask=attention_mask,
                        labels=labels,
                    )
                    loss = outputs.loss
                    self.accelerator.backward(loss)
                    if self.accelerator.sync_gradients:
                        self.accelerator.clip_grad_norm_(self.model.parameters(), max_norm=1.0)
                    self.optimizer.step()
                    self.optimizer.zero_grad(set_to_none=True)

                loss_val = float(loss.detach().item())
                self.global_update_step += 1
                loss_sum += loss_val
                n_step += 1

                if self.accelerator.is_main_process:
                    wandb.log({
                        "train/step": self.global_update_step,
                        "train/loss": loss_val,
                        "train/valid_labels": valid_cnt,
                        "train/dataset": dataset_name,
                        "train/stage_idx": self.current_stage_idx,
                        "epoch": epoch + 1,
                    })

                progress_bar.set_postfix({
                    "Loss": f"{loss_val:.4f}",
                    "Step": f"{step + 1}/{len(dataloader)}",
                    "gStep": self.global_update_step,
                })

            avg_loss = loss_sum / max(n_step, 1)
            if self.accelerator.is_main_process:
                print(f"\n[{dataset_name}] Epoch {epoch + 1} | Avg Loss: {avg_loss:.4f}")
                wandb.log({"epoch/avg_loss": avg_loss, "epoch": epoch + 1})

            gc.collect()
            if torch.cuda.is_available():
                torch.cuda.empty_cache()

            if self.save_per_stage_adapter:
                last_save_path = self._save_adapter(dataset_name, epoch + 1)

        return last_save_path

    # ─────────────────────────────────────────────────────────────────
    # Continual stream
    # ─────────────────────────────────────────────────────────────────
    def train_across_datasets(self):
        """
        CPT stream: 단일 LoRA adapter를 모든 stage에 걸쳐 누적 학습.
        - Optimizer state stage 간 유지
        - 매 stage 종료 시 adapter checkpoint (옵션)
        - 마지막 stage 종료 후 merged full model export (옵션)
        """
        final_adapter_dir = None

        for stage_idx, dataset_file in enumerate(self.dataset_list):
            self.current_stage_idx = stage_idx
            dataset_name = os.path.basename(dataset_file).split(".")[0]

            if self.accelerator.is_main_process:
                print(f"\n{'=' * 60}")
                print(f"[Stage {stage_idx + 1}/{len(self.dataset_list)}] {dataset_name}")
                print(f"  global_update_step before stage : {self.global_update_step}")
                print(f"{'=' * 60}")

            _, dataloader = self.prepare_data(dataset_file)
            last_path = self.train_on_dataset(dataloader, dataset_name)
            if last_path:
                final_adapter_dir = last_path

            del dataloader
            gc.collect()
            if torch.cuda.is_available():
                torch.cuda.empty_cache()

        # ── End of training: wandb finish + merged model export ──
        self.accelerator.wait_for_everyone()
        self.accelerator.end_training()
        if self.wandb_initialized:
            if self.accelerator.is_main_process:
                wandb.finish()
            self.wandb_initialized = False

